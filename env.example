# Copia este archivo como ".env" en la raíz del proyecto y rellena los valores.
# El ".env" real NUNCA debe subirse a git (añádelo a .gitignore).

# Ya existente (CineStock, asistente de procedimientos):
OPENAI_API_KEY=

# Nuevas, para que el botón "ENVIAR A ERP" pueda lanzar el robot
# (src/robot_erp.py) sin pedir usuario/contraseña por teclado:
ERP_USER=
ERP_PASS=

# Opcional. Solo hace falta si el robot (Selenium) vive en un entorno
# Python distinto del que usa CineStock (por ejemplo, un venv aparte).
# Debe apuntar al python.exe de ESE entorno.
# ROBOT_PYTHON=C:\ruta\a\ese\venv\Scripts\python.exe
